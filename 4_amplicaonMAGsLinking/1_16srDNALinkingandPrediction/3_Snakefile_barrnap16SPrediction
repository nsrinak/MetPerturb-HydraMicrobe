SAMPLES = glob_wildcards("./iso_drep_70_20/{sample}.fa").sample

rule all:
  input: 
    expand("./barrnap_result/{sample}_barrnap_16s.fasta", sample=SAMPLES)

rule barrnap:
  input:
    "./iso_drep_70_20/{sample}.fa"
  output:
    "./barrnap_result/{sample}_barrnap_16s.fasta"
  threads: 32
  resources:
    partition="base",
    qos="normal",
    nodes=1,
    mem_mb=500000,
    time="48:00:00"
  shell:
    """
    mkdir -p {wildcards.sample}
    cd {wildcards.sample}
    MarkerMAG barrnap_16s -t {threads} -g {input}
    mv {wildcards.sample}_barrnap_16s_wd/{wildcards.sample}_16S.fasta {output}
    """
